# Nusxa oling: cp .env.example .env  — keyin qiymatlarni to'ldiring.
# .env faylini hech kimga yubormang.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DATABASE_URL=postgresql://localhost:5432/nakladnoy

# Botdan foydalanishi mumkin bo'lgan Telegram user ID'lar (vergul bilan).
# O'z ID'ingizni bilish uchun botga /start yozing — bot ko'rsatadi.
ALLOWED_USER_IDS=

# 1C hujjatidagi doimiy qiymatlar (2-3 rasmdagi ustunlar)
DEFAULT_PODRAZDELENIE=склад снабжения
DEFAULT_NDS=Без НДС
DEFAULT_CURRENCY=UZS

# CSV: 1C/Excel uchun odatda ";" qulay
CSV_DELIMITER=;

# Nusxa oling: cp .env.example .env — keyin qiymatlarni to'ldiring. .env ni hech kimga yubormang.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DATABASE_URL=postgresql://localhost:5432/nakladnoy

# Ixtiyoriy: oldindan ruxsat berilgan Telegram ID'lar (vergul bilan).
# Odatda shart emas: birinchi /start yozgan odam admin bo'ladi, qolganlarga admin tugma bilan ruxsat beradi.
ALLOWED_USER_IDS=

# Ish kuni: 08:00 -> ertasi 07:00, hisobot 07:00 da
TZ_NAME=Asia/Tashkent
REPORT_START_HOUR=8
REPORT_END_HOUR=7
